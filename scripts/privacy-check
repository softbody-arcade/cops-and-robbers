#!/usr/bin/env python3
import argparse
import os
import re
import subprocess
import sys

BOUND_L = r"(?<![0-9A-Za-z:])"
BOUND_R = r"(?![0-9A-Za-z:])"
IPV6 = (r"(?:[0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4}"
        r"|(?:[0-9A-Fa-f]{1,4}:){1,7}:"
        r"|(?:[0-9A-Fa-f]{1,4}:){1,6}(?::[0-9A-Fa-f]{1,4}){1,6}"
        r"|::(?:[0-9A-Fa-f]{1,4}:){0,6}[0-9A-Fa-f]{1,4}")

PATTERNS = [
    ("ipv4", re.compile(r"(?<![0-9.])(?:[0-9]{1,3}\.){3}[0-9]{1,3}(?![0-9]|\.[0-9])")),
    ("ipv6", re.compile(BOUND_L + "(?:" + IPV6 + ")" + BOUND_R)),
    ("email", re.compile(r"[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}")),
    ("login", re.compile(r"(?<![A-Za-z0-9._%+/-])[A-Za-z_][A-Za-z0-9_.-]*@[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)*")),
    ("home", re.compile(r"(?<![A-Za-z0-9])/home/[A-Za-z0-9._-]+|/Users/[^/\s]+|[A-Za-z]:\\+Users\\+")),
    ("server-path", re.compile(r"(?<![A-Za-z0-9])/(?:opt|srv)/[A-Za-z0-9._-]")),
    ("url-login", re.compile(r"[A-Za-z][A-Za-z0-9+.-]*://[^/\s?#]*@[^/\s:@?#]+")),
]

DOC_IPV4 = re.compile(r"^(?:127\.\d+\.\d+\.\d+|0\.0\.0\.0|192\.0\.2\.\d+|198\.51\.100\.\d+|203\.0\.113\.\d+)$")
URL_OK = re.compile(r"^(?:ssh|git\+ssh)://git@github\.com$", re.I)
ADDRESS_OK = re.compile(r"(?:@users\.noreply\.github\.com|^noreply@anthropic\.com|^noreply@openai\.com|^noreply@github\.com|^support@github\.com|^git@github\.com)$", re.I)
DOC_LOGIN = re.compile(r"@(?:192\.0\.2|198\.51\.100|203\.0\.113)\.\d+$")
SKIP_PREFIXES = ()
SKIP_FILES = ("scripts/privacy-check", ".github/privacy-allow.txt", "tests/privacy_check_test.py")
GIT_BASE = ["git", "-c", "core.quotePath=false", "-c", "diff.noprefix=false", "-c", "diff.mnemonicPrefix=false",
            "-c", "core.attributesFile=/dev/null"]
GIT = list(GIT_BASE)


def use_empty_attr_source():
    empty = subprocess.run(["git", "hash-object", "-t", "tree", "/dev/null"], capture_output=True, text=True)
    if empty.returncode != 0:
        raise CheckError("git could not compute the empty tree (needs git 2.41 or newer)")
    GIT[:] = GIT_BASE + [f"--attr-source={empty.stdout.strip()}"]


class CheckError(Exception):
    pass


def read_lines(path):
    if not path or not os.path.exists(path):
        return []
    with open(path, encoding="utf-8") as f:
        return [l.rstrip("\n") for l in f if l.strip() and not l.startswith("#")]


def compile_deny(lines):
    out = []
    for n, l in enumerate(lines, 1):
        try:
            out.append(re.compile(l[3:], re.I) if l.startswith("re:") else re.compile(re.escape(l), re.I))
        except re.error:
            raise CheckError(f"entry {n} of the private term list is not a valid regex")
    return out


def benign(kind, s):
    if kind == "ipv4":
        return bool(DOC_IPV4.match(s)) or any(int(p) > 255 for p in s.split("."))
    if kind == "ipv6":
        low = s.lower()
        return low == "::1" or re.match(r"^2001:0*db8:", low) is not None
    if kind == "url-login":
        return bool(URL_OK.match(s))
    if kind in ("email", "login"):
        return bool(ADDRESS_OK.search(s)) or (kind == "login" and bool(DOC_LOGIN.search(s)))
    return False


def allowed_spans(text, path, allow):
    spans = []
    for entry in allow:
        p, sep, t = entry.partition(":")
        if sep and t and p == path:
            start = text.find(t)
            while start != -1:
                spans.append((start, start + len(t)))
                start = text.find(t, start + 1)
    return spans


def covered(spans, start, end):
    return any(a <= start and end <= b for a, b in spans)


URL_USERINFO = re.compile(r"([A-Za-z][A-Za-z0-9+.-]*://)[^/\s?#]*@")


def redact(text):
    return URL_USERINFO.sub(r"\1***@", text)


def findings(text, deny, path="", allow=()):
    spans = allowed_spans(text, path, allow)
    found = []
    for kind, rx in PATTERNS:
        if any(not benign(kind, m.group(0)) and not covered(spans, m.start(), m.end()) for m in rx.finditer(text)):
            found.append(kind)
    if any(not covered(spans, m.start(), m.end()) for rx in deny for m in rx.finditer(text)):
        found.append("private term")
    private = any(rx.search(text) for rx in deny)
    return found, private


ESCAPES = {"a": 7, "b": 8, "t": 9, "n": 10, "v": 11, "f": 12, "r": 13, '"': 34, "\\": 92}


def unquote(path):
    if not (len(path) >= 2 and path.startswith('"') and path.endswith('"')):
        return path
    body, out, i = path[1:-1], bytearray(), 0
    while i < len(body):
        c = body[i]
        if c == "\\" and i + 1 < len(body):
            nxt = body[i + 1]
            if nxt in "01234567" and i + 3 < len(body) + 1 and all(ch in "01234567" for ch in body[i + 1:i + 4]):
                out.append(int(body[i + 1:i + 4], 8) & 0xFF)
                i += 4
                continue
            out.append(ESCAPES.get(nxt, ord(nxt) if ord(nxt) < 128 else 63))
            i += 2
            continue
        out.extend(c.encode("utf-8"))
        i += 1
    return out.decode("utf-8", "replace")


def skipped(path):
    return path.startswith(SKIP_PREFIXES) or path in SKIP_FILES


def report(out, commit, path, text, deny, allow, where=None):
    kinds, private = findings(text, deny, path, allow)
    if kinds:
        shown = "(line hidden: matches a private term)" if private else redact(text.strip())[:200]
        location = where or path
        if any(rx.search(path) or rx.search(location) for rx in deny):
            location = "(path hidden: matches a private term)"
        out.append((commit, location, ",".join(kinds), shown))


def scan_history(revs, deny, allow):
    out = []
    cmd = GIT + ["log", "-p", "-U0", "--no-color", "--no-renames", "--no-ext-diff", "--diff-merges=first-parent",
                 "--src-prefix=a/", "--dst-prefix=b/",
                 "--format=%x00C %H%n%x00I %an <%ae>%n%x00I %cn <%ce>%n%x00M%n%B%n%x00E", *revs]
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    commit, path, state = None, None, "none"
    for raw in proc.stdout:
        line = raw.rstrip(b"\n").decode("utf-8", "replace")
        if line.startswith("\x00C "):
            commit, path, state = line[3:15], None, "none"
        elif line.startswith("\x00I "):
            report(out, commit, "<identity>", line[3:], deny, ())
        elif line == "\x00M":
            state = "message"
        elif line.startswith("\x00E"):
            state = "none"
        elif state == "message":
            report(out, commit, "<message>", line, deny, allow)
        elif line.startswith("diff --git ") or line.startswith("diff --cc ") or line.startswith("diff --combined "):
            path, state = None, "header"
        elif state == "header" and line.startswith("+++ "):
            target = unquote(line[4:].rstrip("\t"))
            path = target[2:] if target.startswith("b/") else None
        elif state == "header" and line.startswith("@@"):
            state = "hunk"
        elif state == "hunk" and line.startswith("@@"):
            pass
        elif state == "hunk" and line.startswith("+") and path and not skipped(path):
            report(out, commit, path, line[1:], deny, allow)
    proc.stdout.close()
    if proc.wait() != 0:
        raise CheckError(f"git log failed with exit code {proc.returncode}")
    return out


def scan_tree(rev, deny, allow):
    out = []
    oid = subprocess.run(["git", "rev-parse", "--verify", "--quiet", "--end-of-options", rev], capture_output=True, text=True)
    if oid.returncode != 0:
        raise CheckError("the revision to scan could not be resolved")
    oid = oid.stdout.strip()
    tree = subprocess.run(["git", "rev-parse", "--verify", "--quiet", f"{oid}^{{tree}}"], capture_output=True, text=True)
    if tree.returncode != 0:
        raise CheckError("the revision to scan is not a commit or tree")
    commit = subprocess.run(["git", "rev-parse", "--verify", "--quiet", f"{oid}^{{commit}}"], capture_output=True, text=True)
    label = (commit.stdout.strip() if commit.returncode == 0 else tree.stdout.strip())[:12]
    _, colon, sub = rev.partition(":")
    prefix = sub.strip("/") + "/" if colon and sub.strip("/") else ""
    rev = tree.stdout.strip()
    ls = subprocess.run(GIT + ["ls-tree", "-r", "-z", rev], capture_output=True)
    if ls.returncode != 0:
        raise CheckError(f"git ls-tree failed with exit code {ls.returncode}")
    for entry in filter(None, ls.stdout.split(b"\0")):
        meta, _, raw_path = entry.partition(b"\t")
        mode, kind, oid = meta.decode().split()
        path = prefix + raw_path.decode("utf-8", "replace")
        if kind != "blob" or mode == "120000" or skipped(path):
            continue
        blob = subprocess.run(["git", "cat-file", "blob", oid], capture_output=True)
        if blob.returncode != 0:
            raise CheckError(f"could not read a file (git exit code {blob.returncode})")
        if b"\0" in blob.stdout[:8000]:
            continue
        for n, text in enumerate(blob.stdout.decode("utf-8", "replace").split("\n"), 1):
            report(out, label, path, text, deny, allow, where=f"{path}:{n}")
    return out


def main():
    class QuietParser(argparse.ArgumentParser):
        def error(self, message):
            print("privacy-check: invalid arguments (usage: privacy-check history -- <revs> | tree <rev>)", file=sys.stderr)
            sys.exit(2)

    ap = QuietParser(description="Report personal data or private server details in commits or a tree.")
    ap.add_argument("mode", choices=["history", "tree"])
    ap.add_argument("revs", nargs="+", help="history: git log revisions (put them after --); tree: one revision")
    ap.add_argument("--allow", default=".github/privacy-allow.txt")
    ap.add_argument("--deny", help="private term list, default .git/info/privacy-deny when present")
    a = ap.parse_args()
    try:
        deny_path = a.deny
        if deny_path is None:
            git_dir = subprocess.run(["git", "rev-parse", "--git-common-dir"], capture_output=True, text=True).stdout.strip()
            deny_path = os.path.join(git_dir, "info", "privacy-deny") if git_dir else None
        deny = compile_deny(read_lines(deny_path))
        use_empty_attr_source()
        allow = read_lines(a.allow)
        if a.mode == "history":
            out = scan_history(a.revs, deny, allow)
        else:
            out = scan_tree(a.revs[0], deny, allow)
    except CheckError as e:
        print(f"privacy-check: {e}", file=sys.stderr)
        sys.exit(2)
    except Exception as e:
        print(f"privacy-check: internal error ({type(e).__name__})", file=sys.stderr)
        sys.exit(2)
    for commit, path, kind, shown in out:
        print(f"{commit}\t{path}\t{kind}\t{shown}")
    if out:
        print(f"privacy-check: {len(out)} finding(s). Remove them, or add an exact `path:text` line to "
              ".github/privacy-allow.txt if that text is meant to be public.", file=sys.stderr)
    sys.exit(1 if out else 0)


if __name__ == "__main__":
    main()
