#!/usr/bin/env bash

script_dir=${BASH_SOURCE[0]%/*}
[[ $script_dir != "${BASH_SOURCE[0]}" ]] || script_dir=.
CDPATH= cd -- "$script_dir/.." || exit 1

export LC_ALL=C
failed=0

report() {
    printf '%s %s\n' "$1" "$2"
    if [[ $1 != ok ]]; then
        failed=1
        return 1
    fi
}

at_least() {
    local -a found required
    local i actual minimum
    IFS=. read -r -a found <<< "$1"
    IFS=. read -r -a required <<< "$2"
    for i in "${!required[@]}"; do
        actual=${found[i]:-0}
        minimum=${required[i]}
        if (( 10#$actual > 10#$minimum )); then
            return 0
        elif (( 10#$actual < 10#$minimum )); then
            return 1
        fi
    done
    return 0
}

check_tool() {
    local label=$1 command=$2 flag=$3 minimum=$4 hint=$5 required_banner=${6-}
    local output version
    if ! command -v "$command" >/dev/null 2>&1; then
        report missing "$label — $hint"
    elif [[ -z $flag ]]; then
        report ok "$label"
    elif ! output=$("$command" "$flag" 2>&1); then
        report missing "$label (version command failed) — $hint"
    elif [[ -n $required_banner && $output != *"$required_banner"* ]]; then
        report old "$label (need $required_banner) — $hint"
    else
        if [[ $output =~ [0-9]+(\.[0-9]+)+ ]]; then
            version=${BASH_REMATCH[0]}
            if [[ -z $minimum ]] || at_least "$version" "$minimum"; then
                report ok "$label $version"
            else
                report old "$label $version (need $minimum+) — $hint"
            fi
        elif [[ -n $minimum ]]; then
            report missing "$label (version unavailable, need $minimum+) — $hint"
        else
            report ok "$label"
        fi
    fi
}

check_project_access() {
    local auth line scopes
    local project_scope='(^|,)[[:blank:]]*(read:project|project)[[:blank:]]*(,|$)'
    if ! auth=$(GH_PROMPT_DISABLED=1 NO_COLOR=1 CLICOLOR_FORCE=0 gh auth status --active --hostname github.com --no-refresh 2>&1); then
        shopt -s nocasematch
        case "$auth" in
            *"couldn't connect"*|*"could not connect"*|*"error connecting"*|*"timeout trying to log in"*|*"- Error:"*"dial tcp"*|*"- Error:"*"no such host"*|*"- Error:"*"connection refused"*|*"- Error:"*"i/o timeout"*|*"- Error:"*"network is unreachable"*|*"- Error:"*"connection reset by peer"*|*"- Error:"*"context deadline exceeded"*)
                report missing 'gh project access — check your network connection to GitHub, then rerun make doctor' ;;
            *)
                report missing 'gh project access — run gh auth login --hostname github.com, then gh auth refresh --hostname github.com -s read:project' ;;
        esac
        shopt -u nocasematch
        return
    fi

    while IFS= read -r line; do
        if [[ $line =~ ^[[:blank:]]*-[[:blank:]]*Token[[:blank:]]scopes:(.*)$ ]]; then
            scopes=${BASH_REMATCH[1]}
            scopes=${scopes//\'/}
            scopes=${scopes//\"/}
            if [[ $scopes =~ $project_scope ]]; then
                report ok 'gh project access'
                return
            fi
        fi
    done <<< "$auth"
    if [[ -z $scopes ]]; then
        report missing 'gh project access — check token project permissions; use a classic token with read:project if needed'
    else
        report missing 'gh project access — run gh auth refresh --hostname github.com -s read:project, or update token permissions'
    fi
}

check_tool bash bash --version 4.4 'Install or upgrade Bash (pacman -S bash, apt install bash, brew install bash).'
check_tool git git --version 2.41 'Install or upgrade Git (pacman -S git, apt install git, brew install git) or see https://git-scm.com/downloads.'
lua=lua5.3
command -v "$lua" >/dev/null 2>&1 || lua=lua
check_tool Lua "$lua" -v 5.3 'Install Lua (pacman -S lua53, apt install lua5.3, brew install lua).'
check_tool luajit luajit -v '' 'Install LuaJIT (pacman -S luajit, apt install luajit, brew install luajit).'
check_tool python3 python3 --version '' 'Install Python (pacman -S python, apt install python3, brew install python).'
check_tool node node --version 22 'Install Node 22 or newer (pacman -S nodejs, apt install nodejs, brew install node) or see https://nodejs.org/download.'
check_tool npm npm --version '' 'Install npm (pacman -S npm, apt install npm, brew install node).'
check_tool zip zip -v '' 'Install Zip (pacman -S zip, apt install zip, brew install zip).'
check_tool gzip gzip --version '' 'Install gzip (pacman -S gzip, apt install gzip, brew install gzip).'
check_tool sha256sum sha256sum --version '' 'Install GNU coreutils for sha256sum (pacman -S coreutils, apt install coreutils, brew install coreutils).'
check_tool unzip unzip -v '' 'Install UnZip (pacman -S unzip, apt install unzip, brew install unzip).'
check_tool rsync rsync --version '' 'Install rsync (pacman -S rsync, apt install rsync, brew install rsync).'
check_tool tar tar --version '' 'Install GNU tar (pacman -S tar or apt install tar). On macOS, run brew install gnu-tar, then put its gnubin directory first on PATH.' 'GNU tar'
check_tool jq jq --version '' 'Install jq (pacman -S jq, apt install jq, brew install jq).'
check_tool ssh-keygen ssh-keygen '' '' 'Install OpenSSH (pacman -S openssh, apt install openssh-client, brew install openssh).'
if check_tool gh gh --version 2.106 'Install or upgrade GitHub CLI (pacman -S github-cli, apt install gh, brew install gh) or see https://cli.github.com/.'; then
    check_project_access
else
    report missing 'gh project access — install or upgrade gh, then run gh auth status'
fi

if [[ $(git config user.email 2>/dev/null) == ?*@users.noreply.github.com ]]; then
    report ok 'git noreply email'
else
    report missing 'git noreply email — set git config user.email to your GitHub noreply address from https://github.com/settings/emails'
fi

if [[ $(git config core.hooksPath 2>/dev/null) == .githooks ]]; then
    report ok 'git hooks'
else
    report missing 'git hooks — run make hooks'
fi

exit "$failed"
